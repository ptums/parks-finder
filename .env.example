# ============================================================================
# .env.example: key NAMES only. Copy to `.env.local` (gitignored) for local dev.
# AGENTS MUST NEVER READ `.env.local` (or `.env`). Only the human fills it in.
#
# FOR THE INTERVIEWER: the app needs NO keys for the map, list, details, and the
# standard search/filters. To use AI search locally, put your own ANTHROPIC_API_KEY
# in `.env.local` and run `npm run dev`. Without a key the AI search UI is not shown.
# Or skip setup and use the live Fly.io deployment, where AI search is enabled.
# Analytics (PostHog) is optional: without VITE_POSTHOG_KEY it is a no-op.
# ============================================================================

# ---- Local development: server (server/) -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CORS_ORIGIN=http://localhost:5173
PORT=8080
RATE_LIMIT_PER_MINUTE=20
AI_DAILY_REQUEST_CAP=300
LOG_LEVEL=info

# ---- Local development: web (web/). Vite bakes these into the PUBLIC bundle,
# ---- so nothing secret goes here. -------------------------------------------
# If VITE_RAG_URL is unset, or the server has no ANTHROPIC_API_KEY, the AI search UI is not shown.
VITE_RAG_URL=http://localhost:8080
# PostHog project key (starts with phc_). Public by design, but still keep it out of source.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_CAPTURE_QUERY_TEXT=false

# ============================================================================
# Where each value lives in PRODUCTION (reference only; do not fill in here)
# ============================================================================
# GitHub Actions secrets:    FLY_API_TOKEN_WEB, FLY_API_TOKEN_RAG
#                            (fly tokens create deploy -a <app>, one per app)
# GitHub Actions variables:  RAG_URL            https://<FLY_RAG_APP>.fly.dev
#                            SITE_URL           https://<FLY_WEB_APP>.fly.dev
#                            VITE_POSTHOG_KEY   phc_... (public by design)
#                            VITE_POSTHOG_HOST  https://us.i.posthog.com
# Fly secrets on the RAG app: ANTHROPIC_API_KEY, CORS_ORIGIN (=SITE_URL)
#                            (fly secrets import -a <FLY_RAG_APP>  # paste NAME=VALUE on stdin)
# ============================================================================
