{
	auto_https off
}

:8080 {
	root * /srv

	# Fly health check.
	respond /healthz 200

	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# SPA fallback: unknown paths get index.html.
	try_files {path} /index.html
	file_server
}
